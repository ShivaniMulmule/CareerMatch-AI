# ============================================================
# CareerMatch AI - Environment Configuration
# ============================================================

# Environment: development / production
ENVIRONMENT=development

# JWT Authentication Secret (Change in production!)
JWT_SECRET_KEY=careermatch-ai-super-secure-production-key-2026-btech
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (MongoDB)
# If MongoDB is unavailable or empty, CareerMatch AI automatically uses data/local_db.json
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=careermatch_ai

# File Storage Configuration (AWS S3)
# If AWS credentials are empty, CareerMatch AI automatically uses uploads/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=careermatch-ai-resumes-bucket

# Local Uploads Directory
UPLOADS_DIR=uploads

# Port Configuration
PORT=8000
